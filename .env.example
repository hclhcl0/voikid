# VocaKids - Environment Variables
# Copy to .env.local and update with your actual values

# 1. Google Gemini API Key (for phonics, TTS guidance, AI pronunciation & word enrichment)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. PostgreSQL Database (Native Direct Connection for Docker, Coolify, Neon, VPS...)
# When running with docker-compose, this is automatically configured:
DATABASE_URL=postgresql://vocakids:vocakids_secret_password@localhost:5432/vocakids_db

# 3. Optional: Supabase Cloud (Alternative cloud sync)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 4. Optional: writable local profile store (mount a volume when using JSON storage)
# VOCAKIDS_DATA_DIR=/app/data
# Backend management (server only; never use NEXT_PUBLIC_)
VOCAKIDS_ADMIN_PASSWORD=
# Stable server-only signing key for parent/student sessions (generate a separate random secret).
# Coolify: configure both secrets as Runtime Variables; never use NEXT_PUBLIC_.
JWT_SECRET=
# Persistent writable directory for global content. Default: data/backend
VOCAKIDS_CONTENT_DIR=
# Parent/student accounts and family-owned vocabulary (persistent directory)
VOCAKIDS_FAMILY_DIR=
# Optional server-only ElevenLabs key. Can also be configured in Admin > Media.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_ENABLED=false
